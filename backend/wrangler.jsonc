{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blinkpad-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_NAME": "BlinkPad",
    "APP_ENV": "development",
    "ALLOWED_ORIGIN": "http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "blinkpad-storage"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *" // Hourly cleanup
    ]
  }
}

