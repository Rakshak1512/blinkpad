PORT=8787
BACKEND_URL=http://localhost:8787
APP_NAME=BlinkPad
APP_ENV=development
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication & Session Token Secret (min 32 characters)
AUTH_SECRET=your-secure-auth-secret-min-32-characters

# Supabase Configuration (PostgreSQL Database & Supabase Storage)
# The Service Role Key is used exclusively on the backend API server.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Vercel Cron bearer secret used to authorize expired-page cleanup
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
