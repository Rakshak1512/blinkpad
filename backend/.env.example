PORT=8787
BACKEND_URL=http://localhost:8787
APP_NAME=BlinkPad
APP_ENV=development
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://blinkpad-frontend.netlify.app,https://blinkpad-4efw.vercel.app
# Production: keep both deployed frontend origins in ALLOWED_ORIGINS, or put comma-separated origins in APP_BASE_URL.
AUTH_SECRET=your-secure-secret-key-min-32-chars

# Firebase Database Configuration
# Place your service account JSON file at ./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# For Vercel, store the full Firebase service-account JSON in this secret variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Vercel Cron bearer secret used to authorize expired-page cleanup.
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
